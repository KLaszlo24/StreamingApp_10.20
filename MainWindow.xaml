<Window x:Class="StreamingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StreamingApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="600">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Tartalmak keresése"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,10" />

            <TextBox x:Name="FilterTextBox"
                     Height="30"
                     Margin="0,0,0,10"
                     TextChanged="FilterTextBox_TextChanged" />

            <Button Content="Leghosszabb tartalom"
                    Height="32"
                    Margin="0,0,0,10"
                    Click="LongestButton_Click" />

            <TextBlock x:Name="Eredmenyek"
                       Margin="0,0,0,10" />
        </StackPanel>

        <ListBox x:Name="ContentsListBox">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                        <TextBlock Text=" – " />
                        <TextBlock Text="{Binding Length}" />
                        <TextBlock Text=" perc" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
